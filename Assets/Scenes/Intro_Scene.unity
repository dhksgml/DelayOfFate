    - "\uADF8 \uD55C\uACFC \uC6D0\uB150\uC744 \uBA39\uACE0, \uC545\uADC0\uAC00 \uB098\uD0C0\uB0AC\uB2E4."
  - image: {fileID: 1830076832}
    texts:
    - "\uC545\uADC0\uB294 \uC0AC\uB78C\uC758 \uD63C\uC744 \uD0D0\uD588\uB2E4."
    - "\uC545\uADC0\uC758 \uAE30\uC2B5\uC5D0, \uB098\uB294 \uD63C\uC5D0 \uC0C1\uCC98\uB97C
      \uC785\uC5C8\uB2E4."
  - image: {fileID: 1738909663}
    texts:
    - "\uAC04\uC2E0\uD788 \uBAA9\uC228\uB9CC \uBD80\uC9C0\uD574 \uB3C4\uB9DD\uCCE4\uB2E4."
  - image: {fileID: 1703047993}
    texts:
    - "\uD63C\uC758 \uC0C1\uCC98\uB294 \uC18D\uC138\uC758 \uC57D\uC73C\uB85C\uB294
      \uCE58\uC720\uD560 \uC218 \uC5C6\uC5C8\uB2E4."
    - "\uB9C8\uC744\uC5D0, \uD63C\uC758 \uC0C1\uCC98\uB97C \uACE0\uCE5C\uB2E4\uB294
      \uBE44\uC57D\uC758 \uC18C\uBB38\uC774 \uB3CC\uC558\uB2E4."
  - image: {fileID: 2039044497}
    texts:
    - "\uC218\uC18C\uBB38 \uB05D\uC5D0, \uADF8 \uD310\uB9E4\uC0C1\uC744 \uCC3E\uC544\uB0C8\uB2E4."
    - "\uC57D\uC744 \uC0AC\uACE0, \uC0B6\uC744 \uC774\uC5B4\uAC00\uC57C \uD55C\uB2E4."
  textUI: {fileID: 1374148665}
  textDelay: 0.1
  nextTextTime: 1.5
  imageFadeTime: 2
